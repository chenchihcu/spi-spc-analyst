{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spi-spc-analyst",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": { "crons": ["0 2 * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "spi-spc-analyst", "database_id": "PENDING_CLOUDFLARE_RESOURCE" }
  ],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "spi-spc-analyst-blobs" }
  ]
}
