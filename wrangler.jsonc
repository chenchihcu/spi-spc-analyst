{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spi-spc-analyst",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/vendor/*"]
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "AUTH_KDF_ITER": "600000"
  },
  "ratelimits": [
    { "name": "LOGIN_GLOBAL", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "spi-spc", "database_id": "82cea9aa-3555-4073-8739-a583afa9979d", "migrations_dir": "cloudflare/migrations" }
  ],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "spi-spc-record" }
  ]
}
